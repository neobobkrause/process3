{
  "$comment": "One ledger entry per module or feature (REC-9): process/ledger/<id>.json. Every field is fixed once BOB writes it, except status, the one mutable field, which a job changes only on its own entry.",
  "type": "object",
  "required": ["id", "title", "paths", "tests", "requirements", "suite", "reading", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "layer": { "type": "integer" },
    "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requirements": { "type": "string", "minLength": 1 },
    "uses": { "type": "array", "items": { "type": "string" } },
    "suite": {
      "type": "object",
      "required": ["cwd", "command"],
      "additionalProperties": false,
      "properties": {
        "cwd": { "type": "string" },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "test_suffix": { "type": "string" }
      }
    },
    "checks": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
    "reading": { "type": "array", "items": { "type": "string" } },
    "acts": { "type": "array", "items": { "type": "string" } },
    "prior_work": { "type": "string" },
    "status": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["OPEN", "WORKING", "BLOCKED", "COMPLETE"] },
        "reason": { "type": "string" },
        "owner": { "enum": ["bob", "coordinator"] },
        "at": { "type": "string" }
      }
    }
  }
}
